# Copy this file to .env.safe and edit it. Never commit .env.safe.
#
# Set a unique random password before starting Compose. Supply the actual value
# using Compose env-file quoting rules. Mandate handles URL encoding internally.

POSTGRES_USER=artex
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# Required for the first administrator setup. See the README to generate a
# setup token and its digest. Paste only the digest into this file.
# MANDATE_SETUP_TOKEN_SHA256=

# LLM provider. Loaded into the container by docker-compose.safe.yml.
# Prefer entering the key in the console after first boot; if you put it here,
# keep the file mode at 0600.
# Leave blank to infer the provider from whichever key is set.
ARTEX_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
ARTEX_LLM_STREAM=1

# Optional: forbid norma from installing ripgrep with npm at runtime.
NORMA_RIPGREP_NO_INSTALL=1
